{
  "properties": {
    "description": "Runs the Tenant Settings Change Tracker notebook daily and sends email alerts via Outlook when changes are detected.",
    "variables": {
      "emailSubject": {
        "type": "String"
      },
      "pipelineStatus": {
        "type": "String"
      }
    },
    "activities": [
      {
        "name": "Run_Settings_Tracker",
        "type": "TridentNotebook",
        "dependsOn": [],
        "policy": {
          "timeout": "0.02:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "<NOTEBOOK_ID>",
          "workspaceId": "<WORKSPACE_ID>"
        }
      },
      {
        "name": "Check_For_Changes",
        "type": "IfCondition",
        "dependsOn": [
          {
            "activity": "Run_Settings_Tracker",
            "dependencyConditions": ["Succeeded"]
          }
        ],
        "typeProperties": {
          "expression": {
            "type": "Expression",
            "value": "@json(activity('Run_Settings_Tracker').output.result.exitValue).has_changes"
          },
          "ifTrueActivities": [
            {
              "name": "Set_Email_Subject",
              "type": "SetVariable",
              "dependsOn": [],
              "typeProperties": {
                "variableName": "emailSubject",
                "value": "@json(activity('Run_Settings_Tracker').output.result.exitValue).subject"
              }
            },
            {
              "name": "Send_Change_Alert_Email",
              "type": "Office365Email",
              "dependsOn": [
                {
                  "activity": "Set_Email_Subject",
                  "dependencyConditions": ["Succeeded"]
                }
              ],
              "typeProperties": {
                "to": "<YOUR_EMAIL>",
                "subject": "@variables('emailSubject')",
                "body": "@json(activity('Run_Settings_Tracker').output.result.exitValue).body_html",
                "importance": "High",
                "operationType": "SendEmail"
              },
              "externalReferences": {
                "connection": "<OUTLOOK_CONNECTION_ID>"
              }
            }
          ],
          "ifFalseActivities": [
            {
              "name": "Log_No_Changes",
              "type": "SetVariable",
              "dependsOn": [],
              "typeProperties": {
                "variableName": "pipelineStatus",
                "value": "No changes detected"
              }
            }
          ]
        }
      }
    ]
  }
}